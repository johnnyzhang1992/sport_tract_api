{
  "name": "sport-track-api",
  "version": "0.1.0",
  "description": "运动轨迹记录小程序后端服务（Fastify + Mongoose + TypeScript）",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "fastify",
    "mongoose",
    "wechat",
    "miniprogram"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/sts20150401": "^1.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.15.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}

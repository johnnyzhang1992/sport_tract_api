# ===== 复制为 .env.local 填写本地开发值，或部署时设置环境变量 =====
# 敏感信息一律不入库，本文件为模板

# 服务
NODE_ENV=development
PORT=3004
HOST=0.0.0.0

# MongoDB（本地开发可 docker 起实例，见 README）
MONGODB_URI=mongodb://localhost:27017/sport-track-dev

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d

# 微信小程序（公众平台获取）
WX_APPID=
WX_SECRET=
# 本地开发无真实 AppID 时开 mock 登录（任意 code → 固定测试 openid）
WX_MOCK_LOGIN=true

# 腾讯位置服务 WebService API Key（https://lbs.qq.com 创建，勾选 WebService API）
# 用途：轨迹纠偏 trace（运动结束后轨迹贴路）、逆地理编码
TENCENT_MAP_KEY=

# 阿里云 OSS（AK 签名直传，无需 RAM 角色）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_AK_ID=
OSS_AK_SECRET=
OSS_STS_DURATION=900
OSS_BASE_DIR=sport-track

# 生产环境跨域白名单
# 生产 CORS 白名单（逗号分隔多个；webAdmin 独立子域 sport.historybook.cn 需加）
# 例：CORS_ORIGIN=https://sport.historybook.cn,https://admin.historybook.cn
CORS_ORIGIN=

# 管理后台（管理员登录密码 + admin JWT 独立密钥）
ADMIN_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_TOKEN_TTL=12h

# ===== 复制为 .env.local 填写本地开发值，或部署时设置环境变量 =====
# 敏感信息一律不入库，本文件为模板

# 服务
NODE_ENV=development
PORT=3004
HOST=0.0.0.0

# MongoDB（本地开发可 docker 起实例，见 README）
MONGODB_URI=mongodb://localhost:27017/sport-track-dev

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d

# 微信小程序（公众平台获取）
WX_APPID=
WX_SECRET=
# 本地开发无真实 AppID 时开 mock 登录（任意 code → 固定测试 openid）
WX_MOCK_LOGIN=true

# 阿里云 OSS（AK 签名直传，无需 RAM 角色）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_AK_ID=
OSS_AK_SECRET=
OSS_STS_DURATION=900
OSS_BASE_DIR=sport-track

# 生产环境跨域白名单
CORS_ORIGIN=
